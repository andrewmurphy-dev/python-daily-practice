class Ticket:
    def __init__(self, id, name, status, total):
        self.id = id
        self.name = name
        self.status = status 
        self.total = total








ticket = Ticket(
    id=1,
    name="Ticket:1",
    status="open",
    total=1109
)



ticket1 = Ticket(
    id=2,
    name="Ticket:2",
    status="open",
    total=1101
)



ticket2 = Ticket(
    id=3,
    name="Ticket:3",
    status="open",
    total=1103
)


ticket_list = [ticket, ticket1, ticket2]



for ticket_id in ticket_list:
    if ticket_id.id == 2:
        ticket_id.status = "paid"

print(ticket_id.name, ticket_id.status, ticket_id.total)

    









